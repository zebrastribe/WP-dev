MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
WP_PORT=8888
WPDEV_PHP_VERSION=8.2
WP_HTTPS_PORT=8443
WPDEV_LOCAL_HTTPS=0
WPDEV_TERMINAL_PORT=7681
WPDEV_TERMINAL_RUNNER_PORT=7682
WPDEV_HOST_RUNNER_PORT=7683
# Basic auth for browser terminal (format: user:password)
WPDEV_TERMINAL_AUTH=change-me-user:change-me-password
# Required: shared secret for terminal runner API requests
WPDEV_TERMINAL_RUNNER_TOKEN=change-me-runner-token
# Allowed browser origin for terminal runner
WPDEV_TERMINAL_RUNNER_ORIGIN=http://localhost:8888
# Default browser-terminal working directory (must exist in container, e.g. /workspace)
WPDEV_TERMINAL_WORKDIR=/workspace
# Absolute host paths for bind mounts (set by `wp-dev up`). Required when compose
# runs inside the terminal container via docker.sock — relative ../ paths would
# otherwise resolve to /workspace/... on the host and break wp-cli.
# WPDEV_HOST_PROJECT_ROOT=/absolute/path/to/this/repo
# WPDEV_HOST_HOME=/home/you
# Optional: set by `wp-dev up` to the installing host user's uid/gid (never a fixed name)
# WPDEV_HOST_UID=
# WPDEV_HOST_GID=

# Required: random secret; wizard sends X-WP-DEV-Admin-Token on save.
WPDEV_ADMIN_SAVE_TOKEN=change-me-admin-token

# Gate 0 security: trusted Docker network gateway for admin API REMOTE_ADDR checks.
# Set by `wp-dev up` to the fixed compose network gateway (172.28.0.1).
# Normal localhost traffic arrives via docker-proxy at this gateway IP.
WPDEV_ADMIN_TRUSTED_GATEWAY=172.28.0.1

# Gate 0 defense-in-depth: 1 if WP port is bound to 127.0.0.1 only (safe).
# Set by `wp-dev up`. Auto-unlock requires this to be 1.
WPDEV_WP_BIND_LOCAL=1

# Optional: token for /import/ Content Recovery Workspace API
WPDEV_IMPORT_TOKEN=

# Table prefix for local WordPress (must match imported DB if remote used a custom prefix).
# `wp-dev pull` updates this and wp-config.php when it can detect the prefix from the dump.
# WORDPRESS_TABLE_PREFIX=wp_
