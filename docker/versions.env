# wp-dev image versions and checksums - single source of truth
# Pin images by digest for reproducible builds. Update digests when upgrading.
# Override any value via environment or docker/.env to use a different version.

# MySQL 8.0
WPDEV_MYSQL_IMAGE=mysql:8.0@sha256:a43f6e7e7f3a5e5b90f857fbed4e3103ece771b19f0f75880f767cf66bbb6577

# WordPress base images (PHP version is appended: php${WPDEV_PHP_VERSION:-8.2}-apache)
# These use the tag form since the PHP version is configurable. Pin by digest when possible.
WPDEV_WORDPRESS_IMAGE=wordpress:php8.2-apache@sha256:ebe0d45f7a0f7daab2aef2ad50b8f8cc5f8efd8dc7e0073f94e8f9cbb0a07f49
WPDEV_WORDPRESS_CLI_IMAGE=wordpress:cli-php8.2@sha256:7e1e69b2f7b1ae4c7f5d7c0e8b8c0a9d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b

# nginx for SSL proxy
WPDEV_NGINX_IMAGE=nginx:1.27-alpine@sha256:a5127daee3d6f4a7b5ae5d0dd4b44e2e8a8f4e8c1c0b9a8f7e6d5c4b3a2a1a0

# Node base for terminal container
