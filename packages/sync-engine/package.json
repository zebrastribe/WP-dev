{
  "name": "@wpdev/sync-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared WP-dev sync policy (locks, later rsync/wpcli/SSH helpers). CLI and future hosted workers both consume this package — no reimplementation in cloud.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sync-lock": {
      "types": "./dist/sync-lock.d.ts",
      "import": "./dist/sync-lock.js",
      "default": "./dist/sync-lock.js"
    },
    "./ssh-host-key": {
      "types": "./dist/ssh-host-key.d.ts",
      "import": "./dist/ssh-host-key.js",
      "default": "./dist/ssh-host-key.js"
    },
    "./url-variants": {
      "types": "./dist/url-variants.d.ts",
      "import": "./dist/url-variants.js",
      "default": "./dist/url-variants.js"
    },
    "./sync-excludes": {
      "types": "./dist/sync-excludes.d.ts",
      "import": "./dist/sync-excludes.js",
      "default": "./dist/sync-excludes.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  }
}
